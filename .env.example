# Copy to .env and fill in values — NEVER commit .env

# Production site URL (no trailing slash)
EHQ_PROD_SITE_URL=https://your-customer.ehq.example
EHQ_PROD_SITE_DOMAIN=your-customer.ehq.example

# Dedicated production sanity accounts (read-only usage only)
PROD_PARTICIPANT_USERNAME=participant@example.com
PROD_PARTICIPANT_PASSWORD=

PROD_SITEADMIN_USERNAME=siteadmin@example.com
PROD_SITEADMIN_PASSWORD=

# Existing published project slug for read-only navigation checks
PROD_PROJECT_SLUG=existing-published-project

# Optional: platform admin sanity account
# PROD_PLATFORMADMIN_USERNAME=
# PROD_PLATFORMADMIN_PASSWORD=

# Optional: headed mode for debugging
# PW_HEADED=false
